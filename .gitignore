# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated code (build_runner: riverpod_generator, freezed, json_serializable, drift_dev)
*.g.dart
*.freezed.dart
*.drift.dart

# Generated localizations (flutter gen-l10n). The ARB files are the source.
lib/l10n/app_localizations*.dart
l10n_untranslated.json

# Android signing (P24) — never commit the upload keystore or its credentials
android/key.properties
android/*.jks
android/*.keystore

# Cloud Functions (P14) — build output, deps and emulator scratch
functions/node_modules/
functions/lib/
.firebase/
firestore-debug.log
firebase-debug.log
ui-debug.log
